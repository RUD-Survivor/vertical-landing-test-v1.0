{
    "tasks": [
        {
            "type": "shell",
            "label": "Build RocketSim3D Debug",
            "command": "cmd.exe",
            "args": [
                "/C",
                "build_debug.cmd"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build RocketSim3D Release",
            "command": "cmd.exe",
            "args": [
                "/C",
                "build_release.cmd"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build"
        }
    ],
    "version": "2.0.0"
}
