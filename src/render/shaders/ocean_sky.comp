#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common/shared_atmosphere.glsl"
#include "common/ocean_resources.glsl"
layout(set=2,binding=2) uniform sampler2D transmittanceLut;
layout(set=2,binding=4,rgba16f) uniform writeonly image3D skyOutput;
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
const float PI=3.141592653589793;
vec3 sunT(float r,float mu) {
    float radius=ocean.anchorRadius.w*0.001;
    float horizon=-sqrt(max(0.0,1-radius*radius/(r*r)));
    if(mu<horizon)return vec3(0);
    AtmosphereParameters a;a.bottomRadius=radius;a.topRadius=ocean.sunRadius.w;
    vec2 uv;lutTransmittanceParamsToUv(a,r,mu,uv);
    return clamp(textureLod(transmittanceLut,uv,0).rgb,0,1);
}
void main() {
    ivec3 id=ivec3(gl_GlobalInvocationID),size=imageSize(skyOutput);
    if(any(greaterThanEqual(id,size)))return;
    vec3 uv=vec3(id)/vec3(size-1);
    float mu=uv.x*uv.x, mus=uv.y*1.2-0.2, cosAz=uv.z*2-1;
    vec3 ray=vec3(sqrt(max(0,1-mu*mu))*cosAz,mu,
        sqrt(max(0,1-mu*mu))*sqrt(max(0,1-cosAz*cosAz)));
    vec3 L=vec3(sqrt(max(0,1-mus*mus)),mus,0);
    float radius=ocean.anchorRadius.w*0.001,r=radius+0.005;
    vec3 start=vec3(0,r,0);
    float b=r*mu,d=-b+sqrt(max(0,b*b+ocean.sunRadius.w*ocean.sunRadius.w-r*r));
    float nu=dot(ray,L),pr=3/(16*PI)*(1+nu*nu),g=clamp(ocean.params.w,-0.95,0.95);
    float pm=(1-g*g)/(4*PI*pow(max(1+g*g-2*g*nu,0.0025),1.5));
    vec3 tau=vec3(0),radiance=vec3(0);
    for(int i=0;i<24;++i) {
        float t0=float(i)/24,t1=float(i+1)/24,ds=d*(t1*t1-t0*t0);
        vec3 p=start+ray*(d*0.5*(t0*t0+t1*t1));float rp=length(p),h=max(0,rp-radius);
        vec3 br=ocean.rayleigh.rgb*exp(-h/max(ocean.rayleigh.w,0.1));
        vec3 bm=ocean.mie.rgb*exp(-h/max(ocean.mie.w,0.1));
        float ozoneDensity=max(0,1-abs(h-ocean.ozone.w)/max(ocean.ozoneShape.x,0.1));
        vec3 extinction=br+bm+ocean.ozone.rgb*ozoneDensity;
        vec3 source=(br*pr+bm*pm)*sunT(rp,dot(p/rp,L));
        vec3 T=exp(-extinction*ds);
        radiance+=exp(-tau)*source*(1-T)/max(extinction,vec3(1e-8));tau+=extinction*ds;
    }
    // Unit-sun radiance, sampled with actual illumination/exposure at runtime.
    imageStore(skyOutput,id,vec4(max(radiance,vec3(0)),1));
}
